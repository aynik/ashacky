[Unit]
Description=Ashacky virtual FIDO2 transport
Wants=ashacky-control.service
After=ashacky-control.service
ConditionPathExists=/dev/uhid

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/ashacky-fido2
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=3
RuntimeDirectory=ashacky-fido2
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/ashacky-fido2
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
