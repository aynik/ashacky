[Unit]
Description=LinuxHost native audio endpoint selection
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
ExecStart=/usr/bin/python3 /opt/linuxhost-probe/audio_pipewire.py --duration 0
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=yes

[Install]
WantedBy=default.target
