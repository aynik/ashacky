[Unit]
Description=LinuxHost desktop audio management bridge
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/linuxhost-probe/device_service.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=linuxhost-devices
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/linuxhost-devices

[Install]
WantedBy=multi-user.target
