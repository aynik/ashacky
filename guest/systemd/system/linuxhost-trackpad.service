[Unit]
Description=LinuxHost native multitouch trackpad
After=systemd-udevd.service

[Service]
ExecStart=/usr/bin/python3 /opt/linuxhost-probe/trackpad/trackpad.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
