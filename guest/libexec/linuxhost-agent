#!/usr/bin/python3
"""Root-owned, bounded RPC bridge. Never accepts shell commands."""
import json
import os
import pathlib
import select
import socket
import struct
import subprocess
import threading
import time

CONFIG = pathlib.Path('/etc/linuxhost.json')
RUNTIME = pathlib.Path('/run/linuxhost')
STATUS_PORT = pathlib.Path('/dev/virtio-ports/org.ashacky.status')
ALLOWED = {'status', 'powercheck', 'lock', 'sleep', 'poweroff', 'restart', 'logout', 'authenticate'}

def host_request(request):
    config = json.loads(CONFIG.read_text())
    request = dict(request, token=config['token'])
    endpoint = config['hostSocket']
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(80)
        client.connect(endpoint)
        client.sendall(json.dumps(request).encode() + b'\n')
        result = client.makefile('rb').readline(16384)
        return json.loads(result)

def status_stream(port=STATUS_PORT):
    """Bounded, read-only host telemetry; this channel never accepts commands."""
    fd = os.open(port, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        buffer = b''
        while True:
            if not select.select([fd], [], [], 25)[0]:
                raise TimeoutError('Host status heartbeat expired')
            chunk = os.read(fd, 4096)
            if not chunk:
                raise EOFError('Host status port disconnected')
            buffer += chunk
            while b'\n' in buffer:
                line, buffer = buffer.split(b'\n', 1)
                if len(line) > 16384:
                    raise ValueError('Host status message too large')
                message = json.loads(line)
                if not isinstance(message, dict) or type(message.get('version')) is not int or message['version'] != 1:
                    raise ValueError('Unsupported host status protocol')
                status = message.get('status')
                if not isinstance(status, dict) or status.get('ok') is not True:
                    raise ValueError('Invalid host status')
                yield status
            if len(buffer) > 16384:
                raise ValueError('Host status message too large')
    finally:
        os.close(fd)


def save_status(status, transport, generation):
    if not isinstance(status, dict) or status.get('ok') is not True:
        raise ValueError('Host status unavailable')
    new_generation = status.get('wakeGeneration')
    temporary = RUNTIME / 'status.tmp'
    temporary.write_text(json.dumps(dict(status, statusTransport=transport)))
    temporary.chmod(0o644)
    temporary.replace(RUNTIME / 'status.json')
    if generation is not None and new_generation != generation:
        # Publish power telemetry first; a clock-service restart must not hold it up.
        try:
            subprocess.run(['systemctl', 'try-restart', 'systemd-timesyncd.service', '--no-block'],
                           timeout=10, check=False)
        except (OSError, subprocess.SubprocessError) as error:
            print('Clock refresh:', error, flush=True)
    return new_generation


def refresh_status():
    generation, mode = None, None
    while True:
        try:
            for status in status_stream():
                if mode != 'virtio-serial':
                    print('Host status: event channel connected', flush=True)
                    mode = 'virtio-serial'
                generation = save_status(status, mode, generation)
        except (OSError, EOFError, ValueError):
            # Older VM configurations have no status port. Retain their RPC
            # path, and also recover telemetry while the frontend reconnects.
            if mode != 'rpc-poll':
                print('Host status: using compatibility RPC polling', flush=True)
                mode = 'rpc-poll'
        try:
            generation = save_status(host_request({'action': 'status'}), mode, generation)
        except Exception as error:
            print('Status refresh:', error, flush=True)
        time.sleep(5)

def authorize(request, uid, desktop_uid):
    if uid not in (0, desktop_uid):
        raise PermissionError('Only the Linux desktop user may use this service')
    if not isinstance(request, dict):
        raise ValueError('Expected request object')
    action = request.get('action')
    if action not in ALLOWED:
        raise ValueError('Unsupported action')
    if action == 'authenticate':
        if request.get('purpose') not in ('test', 'sudo', 'unlock'):
            raise ValueError('Unsupported authentication purpose')
        if request['purpose'] in ('sudo', 'unlock') and uid != 0:
            raise PermissionError('Authentication integration requires PAM/root')
    # Drop unknown fields, especially caller-supplied tokens and commands.
    outgoing = {'action': action}
    if action == 'authenticate':
        outgoing['purpose'] = request['purpose']
    return outgoing


def serve():
    RUNTIME.mkdir(mode=0o755, exist_ok=True)
    endpoint = RUNTIME / 'agent.sock'
    endpoint.unlink(missing_ok=True)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
        server.bind(str(endpoint))
        endpoint.chmod(0o666)  # Peer UID is checked below, including for read operations.
        server.listen(8)
        threading.Thread(target=refresh_status, daemon=True).start()
        while True:
            client, _ = server.accept()
            with client:
                client.settimeout(5)
                try:
                    _, uid, _ = struct.unpack('3i', client.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                    payload = client.makefile('rb').readline(4096)
                    if not payload.endswith(b'\n'):
                        raise ValueError('Invalid request')
                    outgoing = authorize(json.loads(payload), uid, json.loads(CONFIG.read_text())['userID'])
                    result = host_request(outgoing)
                    client.sendall(json.dumps(result).encode() + b'\n')
                    if result.get('ok') and result.get('shutdownGuest'):
                        subprocess.run(['systemctl', 'poweroff', '--no-block'], timeout=10, check=True)
                except Exception as error:
                    try:
                        client.sendall(json.dumps({'ok': False, 'error': str(error)}).encode() + b'\n')
                    except OSError:
                        pass

if __name__ == '__main__':
    serve()
