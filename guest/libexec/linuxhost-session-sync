#!/usr/bin/python3
"""Fixed host-authenticated SSH endpoint; never logs in a new guest session."""
import json,os,pathlib,subprocess,sys,time

def sessions(uid):
    ids=subprocess.check_output(['loginctl','list-sessions','--no-legend','--no-pager'],text=True,timeout=5)
    result=[]
    for line in ids.splitlines():
        sid=line.split()[0]
        raw=subprocess.check_output(['loginctl','show-session',sid,'-p','User','-p','Class','-p','Type','-p','Remote','-p','Active','-p','LockedHint'],text=True,timeout=5)
        p=dict(line.split('=',1) for line in raw.splitlines() if '=' in line)
        if p.get('User')==str(uid) and p.get('Class')=='user' and p.get('Type') in ('wayland','x11') and p.get('Remote')=='no' and p.get('Active')=='yes':
            result.append((sid,p.get('LockedHint')=='yes'))
    return result

def watch(uid):
    from gi.repository import Gio, GLib
    bus=Gio.bus_get_sync(Gio.BusType.SYSTEM,None)
    def call(path,interface,method,args=None):
        return bus.call_sync('org.freedesktop.login1',path,interface,method,args,None,Gio.DBusCallFlags.NONE,5000,None).unpack()
    previous=None
    last_emit=0
    origin='guest'
    while True:
        rows=call('/org/freedesktop/login1','org.freedesktop.login1.Manager','ListSessions')[0]
        ids=[]
        for sid,user,name,seat,path in rows:
            if user!=uid:continue
            props=call(path,'org.freedesktop.DBus.Properties','GetAll',GLib.Variant('(s)',('org.freedesktop.login1.Session',)))[0]
            if props.get('Class')=='user' and props.get('Type') in ('wayland','x11') and not props.get('Remote') and props.get('Active') and props.get('LockedHint'):
                ids.append(sid)
        state=tuple(sorted(ids))
        if state!=previous:
            origin='guest'
            marker=pathlib.Path('/run/linuxhost/session-sync-host-lock.json')
            try:
                record=json.loads(marker.read_text())
                if state and time.monotonic()<record['expires'] and set(state)<=set(record['sessions']):
                    origin='host';marker.unlink(missing_ok=True)
            except (OSError,ValueError,KeyError):pass
        if state!=previous or time.monotonic()-last_emit>=5:
            print(json.dumps({'locked':bool(state),'sessions':list(state),'origin':origin}),flush=True)
            last_emit=time.monotonic()
        previous=state
        time.sleep(0.5)

def main():
    if os.geteuid()!=0:raise PermissionError('Host session integration requires root')
    action=sys.argv[1] if len(sys.argv)==2 else ''
    if action not in ('status','lock','unlock','watch'):raise ValueError('Expected status, lock, or unlock')
    uid=json.loads(pathlib.Path('/etc/linuxhost.json').read_text())['userID']
    if action=='watch':watch(uid);return
    targets=sessions(uid)
    if action=='lock':
        marker=pathlib.Path('/run/linuxhost/session-sync-host-lock.json')
        marker.write_text(json.dumps({'sessions':[sid for sid,locked in targets],'expires':time.monotonic()+5}))
        marker.chmod(0o600)
    if action!='status':
        for sid,locked in targets:
            if action=='unlock' and not locked:continue
            subprocess.run(['loginctl',action+'-session',sid],check=True,timeout=5)
    print(json.dumps({'action':action,'sessions':[{'id':sid,'locked':locked} for sid,locked in targets]}))
if __name__=='__main__':main()
