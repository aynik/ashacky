 - (void) doToggleFullScreen:(id)sender
 {
+    if (linuxhost_kiosk_configured) {
+        NSWindow *w = [cocoaView window];
+        linuxhost_kiosk = !linuxhost_kiosk;
+        [cocoaView ungrabMouse];
+        [NSApp setPresentationOptions:linuxhost_kiosk ? NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar : NSApplicationPresentationDefault];
+        [w setStyleMask:linuxhost_kiosk ? NSWindowStyleMaskBorderless : NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskResizable | NSWindowStyleMaskMiniaturizable];
+        [w setCollectionBehavior:NSWindowCollectionBehaviorFullScreenNone];
+        if (linuxhost_kiosk) [w setFrame:[[w screen] frame] display:YES];
+        else { [w setContentSize:NSMakeSize(960,600)]; [w center]; }
+        [w makeKeyAndOrderFront:nil];
+        [cocoaView updateUIInfo];
+        return;
+    }
     [[cocoaView window] toggleFullScreen:sender];
 }
 
