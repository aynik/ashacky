+static GPtrArray *linuxhost_displays;
+
+#if defined(HAVE_SPICE_GL) && defined(CONFIG_IOSURFACE)
+static void spice_refresh_client_scanout(void *opaque)
+{
+    SimpleSpiceDisplay *ssd = opaque;
+    int fourcc, fd;
+    if (!ssd->have_scanout || !ssd->iosurface) {
+        return;
+    }
+    /* A pipe transports the surface ID, not persistent bytes. A new client
+     * needs a fresh pipe even when the guest has not changed its scanout. */
+    fd = spice_iosurface_create_fd(ssd, &fourcc);
+    if (fd < 0) {
+        return;
+    }
+    spice_qxl_gl_scanout(&ssd->qxl, fd,
+                        IOSurfaceGetWidth(ssd->iosurface),
+                        IOSurfaceGetHeight(ssd->iosurface),
+                        IOSurfaceGetBytesPerRow(ssd->iosurface),
+                        fourcc, ssd->y_0_top);
+    qemu_spice_gl_monitor_config(ssd, ssd->scanout_last_x, ssd->scanout_last_y,
+                                ssd->scanout_last_w, ssd->scanout_last_h);
+    if (!qemu_console_is_gl_blocked(ssd->dcl.con)) {
+        qemu_spice_gl_update(&ssd->dcl, 0, 0,
+                            ssd->scanout_last_w, ssd->scanout_last_h);
+    }
+}
+#endif
+
+void qemu_spice_display_client_connected(int channel_id)
+{
+#if defined(HAVE_SPICE_GL) && defined(CONFIG_IOSURFACE)
+    if (!linuxhost_displays) {
+        return;
+    }
+    for (guint i = 0; i < linuxhost_displays->len; i++) {
+        SimpleSpiceDisplay *ssd = g_ptr_array_index(linuxhost_displays, i);
+        if (ssd->qxl.id == channel_id) {
+            /* Leave the server's channel callback before changing scanout. */
+            aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                                   spice_refresh_client_scanout, ssd);
+        }
+    }
+#endif
+}
